{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default freqtrade renovate config",
  "extends": [
    "config:recommended",
    ":maintainLockFilesMonthly",
    ":semanticCommitTypeAll(chore)",
    "schedule:monthly"
  ],
  "meteor": {
    "enabled": false
  },
  "labels": ["Dependencies"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "7 days",
  "prHourlyLimit": 0,
  "npm": {
    "commitMessageTopic": "{{prettyDepType}} {{depName}}"
  },
  "packageRules": [
    {
      "description": "Label Python updates.",
      "matchCategories": ["python"],
      "addLabels": ["Python"]
    },
    {
      "description": "Label JavaScript updates.",
      "matchCategories": ["js"],
      "addLabels": ["javascript"]
    },
    {
      "description": "Label GitHub Actions updates.",
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"]
    },
    {
      "description": "Label Docker updates.",
      "matchCategories": ["docker"],
      "addLabels": ["docker"]
    },
    {
      "description": "Group minor and patch updates into one PR per package manager.",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "{{manager}} non-major dependencies",
      "groupSlug": "{{manager}}-minor-patch"
    },
    {
      "description": "Split npm devDependencies into their own non-major group.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major devDependencies",
      "groupSlug": "npm-dev-minor-patch"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchDepNames": ["node"],
      "enabled": false
    },
    {
      "description": "Keep major-only runtime versions in workflow inputs (e.g. node@24) instead of pinning them to exact versions.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "rangeStrategy": "replace"
    },
    {
      "description": "Keep major-only node versions in version files (e.g. .nvmrc: 22) instead of pinning them to exact versions.",
      "matchManagers": ["nvm", "nodenv"],
      "rangeStrategy": "replace"
    },
    {
      "description": "Lock file maintenance has no release timestamp, so Renovate's age check would stay pending forever. pnpm's minimumReleaseAge enforces it instead.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "description": "Group Python non-major updates across managers, so pyproject.toml and requirements files are bumped in the same PR.",
      "matchDatasources": ["pypi"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python non-major dependencies",
      "groupSlug": "python-minor-patch"
    },
    {
      "description": "Split Python dev requirements into their own non-major group.",
      "matchDatasources": ["pypi"],
      "matchFileNames": ["**/requirements-dev.txt"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python non-major dev dependencies",
      "groupSlug": "python-dev-minor-patch"
    },
    {
      "description": "Keep ta-lib updates in their own PR, separate from other Python dependencies.",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["/^ta[-_.]?lib$/i"],
      "groupName": "ta-lib",
      "groupSlug": "ta-lib"
    },
    {
      "description": "Keep ccxt updates in their own PR, bumping the Python and JS packages together. ccxt releases frequently, so use a short minimum release age.",
      "matchDatasources": ["pypi", "npm"],
      "matchPackageNames": ["ccxt"],
      "groupName": "ccxt",
      "groupSlug": "ccxt",
      "minimumReleaseAge": "2 hours"
    },
    {
      "description": "Keep pyproject.toml ranges (e.g. >=2.0) untouched while the new version is in range - only the lock file gets updated.",
      "matchManagers": ["pep621", "poetry"],
      "rangeStrategy": "update-lockfile"
    }
  ],
  "postUpdateOptions": [
    "pnpmDedupe"
  ]
}
